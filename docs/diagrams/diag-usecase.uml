@startuml
<style>
root {
  BackgroundColor #FAFBFC
  FontName "Segoe UI"
  FontSize 13
  Shadowing false
  DPI 160
  LineType ortho
  NodeSep 50
  RankSep 90
  Padding 10
  RoundCorner 12
}

actor {
  BackgroundColor #EAF2FB
  BorderColor #1F5FA8
  FontColor #0B2E4F
  FontStyle bold
}

usecase {
  BackgroundColor #FFF3CD
  BorderColor #B8860B
  FontColor #4A3400
  FontStyle bold
}

rectangle {
  BackgroundColor #FFFFFF
  BorderColor #3A4A5A
  FontColor #1F2937
  RoundCorner 12
}

arrow {
  LineColor #455A64
  FontColor #37474F
  FontSize 11
}
</style>

skinparam actorStyle awesome

' ============ АКТОРЫ ============
actor "Пользователь" as Speaker
actor "Оператор" as Operator
actor "Zigbee-устройство" as ZigbeeDevice <<device>> #E8F5E9

' ============ ГРАНИЦА СИСТЕМЫ ============
rectangle "Домашняя AI-станция" as SysBoundary {

  usecase "UC-01. Исполнить голосовую\nкоманду Zigbee-устройством" as UC1
  usecase "UC-02. Проиндицировать\nстатус Системы" as UC2
  usecase "UC-03. Диагностика\nи мониторинг Системы" as UC3
  usecase "UC-04. Обновить прошивку" as UC4

}

' ============ СВЯЗИ АКТОРОВ ============
Operator --> UC3
Speaker  --> UC1 : говорит
Speaker  --> UC2 : наблюдает
Speaker  --> UC4 : нажимает

' ============ СВЯЗИ С ВНЕШНИМ УСТРОЙСТВОМ ============
UC1 --> ZigbeeDevice : команда управления

' ============ ОТНОШЕНИЯ МЕЖДУ UC ============
UC1 ..> UC2 : <<include>>

' ============ ЛЕГЕНДА ============
legend right
  |= Цвет |= Категория |
  | <#FFF3CD> | Use cases |
  | <#EAF2FB> | Роли пользователей |
  | <#E8F5E9> | Внешнее Zigbee-устройство |
  | пунктир | Отношение <<include>> / <<extend>> |
endlegend
@enduml
